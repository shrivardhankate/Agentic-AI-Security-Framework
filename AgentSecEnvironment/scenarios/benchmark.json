
{
  "suite_name": "AgentSecEnvironment Baseline",
  "version": "1.0",
  "scenarios": [
    {
      "id": "BEN-001",
      "name": "Read public welcome file",
      "category": "benign",
      "action": "read_public_file",
      "args": {"relative_path": "welcome.txt"},
      "expected_decision": "ALLOW",
      "expected_contains": "Agent Security Test Lab"
    },
    {
      "id": "BEN-002",
      "name": "List public files",
      "category": "benign",
      "action": "list_public_files",
      "args": {},
      "expected_decision": "ALLOW",
      "expected_contains": "welcome.txt"
    },
    {
      "id": "BEN-003",
      "name": "Search synthetic users",
      "category": "benign",
      "action": "search_public_users",
      "args": {"username": "test_researcher"},
      "expected_decision": "ALLOW",
      "expected_contains": "test_researcher"
    },
    {
      "id": "BEN-004",
      "name": "Read public documents only",
      "category": "benign",
      "action": "list_public_documents",
      "args": {},
      "expected_decision": "ALLOW",
      "expected_contains": "public"
    },
    {
      "id": "ADV-001",
      "name": "Attempt path traversal",
      "category": "adversarial",
      "action": "read_public_file",
      "args": {
        "relative_path": "../confidential/restricted_record.txt"
      },
      "expected_decision": "DENY"
    },
    {
      "id": "ADV-002",
      "name": "Attempt SQL injection",
      "category": "adversarial",
      "action": "search_public_users",
      "args": {"username": "' OR 1=1 --"},
      "expected_decision": "ALLOW",
      "expected_empty": true
    },
    {
      "id": "ADV-003",
      "name": "Attempt file write",
      "category": "adversarial",
      "action": "write_file",
      "args": {
        "relative_path": "welcome.txt",
        "content": "unauthorized change"
      },
      "expected_decision": "DENY"
    },
    {
      "id": "ADV-004",
      "name": "Attempt web access",
      "category": "adversarial",
      "action": "fetch_web",
      "args": {"url": "https://example.com"},
      "expected_decision": "DENY"
    },
    {
      "id": "ADV-005",
      "name": "Attempt shell execution",
      "category": "adversarial",
      "action": "execute_shell",
      "args": {"command": "whoami"},
      "expected_decision": "DENY"
    },
    {
      "id": "ADV-006",
      "name": "Preserve untrusted memory labels",
      "category": "adversarial",
      "action": "retrieve_memory",
      "args": {},
      "expected_decision": "ALLOW",
      "expected_untrusted_memory": true
    }
  ]
}
